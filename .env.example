# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# MongoDB Atlas Free cluster. REQUIRED in production; local JSON storage is development-only.
MONGODB_URI=""
PORT="3000"
NODE_ENV="development"
DISABLE_STATIC_UI="0"
RUN_LOGISTICS_WORKER="0"
ROOT_SUPERUSER_EMAIL="ashvinsingh25@gmail.com"
# Set a unique, one-time bootstrap password in the host secret manager; rotate after first login.
ROOT_SUPERUSER_INITIAL_PASSWORD=""

# Auth & Guest Session Signing Secret
SESSION_SECRET="change-this-in-production-to-a-32-char-random-secret"

# Supabase Auth (server-side)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
# Browser OAuth client (same Supabase project URL and public anon/publishable key)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Logistics workflow database (Supabase Postgres). Required for carrier/warehouse/shipment workflows.
# Shiprocket API base URL (official API host; keep default unless Shiprocket provides a regional endpoint).
SHIPROCKET_API_BASE_URL="https://apiv2.shiprocket.in"
# Optional: set the Shiprocket courier company ID to prioritize a courier (e.g. Shadowfax if enabled on your account).
# This can also be passed per shipment as courierId in the logistics job payload.
SHIPROCKET_SHADOWFAX_COURIER_ID=""
# Webhook-free tracking poller runs every 3 hours; AWBs are queried sequentially with 500ms spacing.
LOGISTICS_SUPABASE_URL=""
LOGISTICS_SUPABASE_SERVICE_ROLE_KEY=""

# Field encryption key: generate with `openssl rand -base64 32`; required for gateway secrets
ENCRYPTION_MASTER_KEY=""
# Comma-separated exact storefront origins, e.g. https://ecommerce-ui.onrender.com
CORS_ALLOWED_ORIGINS=""
# Public Lean API origin injected when building the Static UI bundle
VITE_API_BASE_URL=""
# Optional media CDN or API origin for /uploads assets when split across domains
VITE_ASSET_BASE_URL=""
# Optional sign-in origin for a separately hosted provider portal
VITE_CUSTOMER_APP_URL="http://localhost:4173"

# Upstash Redis (Free Tier — optional, falls back to local store)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cloudflare R2 (10GB Free Storage, zero egress — optional, falls back to local /uploads WebP)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_CDN_URL=""

# Meta WhatsApp Cloud API / Evolution API (optional, generates wa.me deep-links if omitted)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE=""

# Optional external maintenance endpoint
CRON_SECRET=""

# Standalone Microservices (optional — leave URLs blank for single-server local fallback)
PAYMENT_SERVICE_PORT="4010"
SHIPPING_SERVICE_PORT="4020"
PAYMENT_SERVICE_URL=""
SHIPPING_SERVICE_URL=""
# Shared HMAC-SHA256 secret (generate via `openssl rand -hex 32`) required when calling standalone services
SERVICE_INTERNAL_SECRET=""
# Enable logistics booking poller inside standalone shipping-service ("0" disables background polling)
ENABLE_QUEUE_WORKER="0"
