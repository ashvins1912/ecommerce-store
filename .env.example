# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# MongoDB Atlas M0 Free Tier (optional — runs on local persistent JSON engine if omitted)
MONGODB_URI=""

# Auth & Guest Session Signing Secret
SESSION_SECRET="change-this-in-production-to-a-32-char-random-secret"

# Supabase Auth (Customer Sign-Up & Sign-In)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Upstash Redis (Free Tier — optional, falls back to local store)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cloudflare R2 (10GB Free Storage, zero egress — optional, falls back to local /uploads WebP)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_CDN_URL=""

# Meta WhatsApp Cloud API / Evolution API (optional, generates wa.me deep-links if omitted)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE=""

# Cron secret for GitHub Actions 6-hour trending recalculation
CRON_SECRET=""
