# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# MongoDB Atlas M0 Free Tier (optional — runs on local persistent JSON engine if omitted)
MONGODB_URI=""

# Auth & Guest Session Signing Secret
SESSION_SECRET="change-this-in-production-to-a-32-char-random-secret"

# Supabase Auth (server-side)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
# Browser OAuth client (same Supabase project URL and public anon/publishable key)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Field encryption key: generate with `openssl rand -base64 32`; required for gateway secrets
ENCRYPTION_MASTER_KEY=""
# Comma-separated exact storefront origins, e.g. https://shop.example.com
CORS_ALLOWED_ORIGINS=""
# Optional sign-in origin for a separately hosted provider portal
VITE_CUSTOMER_APP_URL="http://localhost:4173"

# Upstash Redis (Free Tier — optional, falls back to local store)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cloudflare R2 (10GB Free Storage, zero egress — optional, falls back to local /uploads WebP)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_CDN_URL=""

# Meta WhatsApp Cloud API / Evolution API (optional, generates wa.me deep-links if omitted)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE=""

# Cron secret for GitHub Actions 6-hour trending recalculation
CRON_SECRET=""
