{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "dev:customer": "vite --config apps/customer-web/vite.config.ts",
    "build:customer": "vite build --config apps/customer-web/vite.config.ts",
    "dev:seller": "vite --config apps/seller-hub/vite.config.ts",
    "build:seller": "vite build --config apps/seller-hub/vite.config.ts",
    "dev:provider": "vite --config apps/provider-portal/vite.config.ts",
    "build:provider": "vite build --config apps/provider-portal/vite.config.ts",
    "build:workspace": "npm run build:customer && npm run build:seller && npm run build:provider",
    "logistics:worker": "RUN_LOGISTICS_WORKER=1 tsx apps/logistics-worker/src/run.ts",
    "test:logistics": "tsx --test packages/logistics-core/src/index.test.ts packages/adapters/shadowfax/src/index.test.ts packages/adapters/shiprocket/src/index.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/multer": "^2.3.0",
    "@upstash/redis": "^1.41.0",
    "@vitejs/plugin-react": "^6.1.1",
    "browser-image-compression": "^2.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "embla-carousel-react": "^8.6.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "mongoose": "^9.12.1",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-inner-image-zoom": "^4.0.2",
    "recharts": "^3.10.1",
    "sharp": "^0.35.5",
    "vite": "^8.3.0",
    "wink-sentiment": "^5.0.2",
    "yet-another-react-lightbox": "^3.33.1",
    "zod": "^4.6.7",
    "@commerce/shared-types": "^1.0.0",
    "@commerce/shared-utils": "^1.0.0",
    "@commerce/shared-ui": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  },
  "workspaces": [
    "apps/customer-web",
    "apps/seller-hub",
    "apps/provider-portal",
    "packages/shared-types",
    "packages/shared-utils",
    "packages/shared-ui",
    "packages/logistics-core",
    "packages/adapters/shadowfax",
    "packages/adapters/shiprocket",
    "apps/logistics-worker"
  ]
}
