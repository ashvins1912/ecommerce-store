{
  "name": "ecommerce-store",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "bash scripts/build-all.sh",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "start:app": "bash scripts/start-app.sh",
    "dev:customer": "cd customer-web && bun run dev",
    "build:customer": "cd customer-web && bun run build",
    "start:customer": "cd customer-web && bun run start",
    "dev:provider": "cd provider-portal && bun run dev",
    "build:provider": "cd provider-portal && bun run build",
    "build:workspace": "bash scripts/build-all.sh",
    "dev:payment": "cd payment-service && bun run dev",
    "start:payment": "cd payment-service && bun run start",
    "dev:shipping": "cd shipping-service && bun run dev",
    "start:shipping": "cd shipping-service && bun run start",
    "logistics:worker": "tsx shipping-service/src/worker-entry.ts",
    "test:logistics": "tsx --test packages/logistics-core/src/index.test.ts packages/adapters/shadowfax/src/index.test.ts packages/adapters/shiprocket/src/index.test.ts",
    "test:hybrid": "tsx --test packages/hybrid-engine/src/index.test.ts",
    "test": "bun run test:logistics && bun run test:hybrid && bun run test:privacy && bun run test:sitemap && bun run test:platform && bun run test:microservices && bun run test:whatsapp",
    "dev:all": "bash scripts/dev-all.sh",
    "test:privacy": "tsx --test src/server/services/privacy.test.ts",
    "test:roles": "tsx --test src/server/services/roles.test.ts",
    "test:sitemap": "tsx --test src/server/services/sitemap.test.ts",
    "test:platform": "tsx --test src/server/services/platformConfig.test.ts",
    "test:microservices": "tsx --test src/server/services/serviceGateway.test.ts",
    "test:whatsapp": "tsx --test src/server/services/whatsapp.test.ts",
    "predeploy:check": "bash scripts/predeploy-check.sh",
    "build:all": "bash scripts/build-all.sh",
    "test:all": "bun run test",
    "verify": "bun run lint && bun run test:all && bun run build:all"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@commerce/shared-types": "^1.0.0",
    "@commerce/shared-ui": "^1.0.0",
    "@commerce/shared-utils": "^1.0.0",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/multer": "^2.3.0",
    "@upstash/redis": "^1.41.0",
    "@vitejs/plugin-react": "^6.1.1",
    "browser-image-compression": "^2.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "driver.js": "^1.14.0",
    "embla-carousel-react": "^8.6.0",
    "express": "^4.21.2",
    "i18next": "^27.1.3",
    "i18next-browser-languagedetector": "^8.3.0",
    "lucide-react": "^0.546.0",
    "mongoose": "^9.12.1",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-i18next": "^18.0.2",
    "react-inner-image-zoom": "^4.0.2",
    "recharts": "^3.10.1",
    "sharp": "^0.35.5",
    "vite": "^8.3.0",
    "wink-sentiment": "^5.0.2",
    "yet-another-react-lightbox": "^3.33.1",
    "zod": "^4.6.7",
    "compression": "^1.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21",
    "@types/compression": "^1.8.1"
  },
  "workspaces": [
    "customer-web",
    "provider-portal",
    "api",
    "payment-service",
    "shipping-service",
    "packages/shared-types",
    "packages/shared-utils",
    "packages/shared-ui",
    "packages/logistics-core",
    "packages/adapters/shadowfax",
    "packages/adapters/shiprocket",
    "packages/hybrid-engine"
  ],
  "packageManager": "bun@1.4.3"
}
